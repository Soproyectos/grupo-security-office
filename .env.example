# ============================================================
# Grupo Security Office — Variables de Entorno
# ============================================================
# Copiar a .env y ajustar valores
#   cp .env.example .env
# Nunca comitear .env al repo.

# ──── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grupo_security?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grupo_security

# ──── API (NestJS) ─────────────────────────────────────────
JWT_SECRET=dev-secret-no-usar-en-prod
JWT_EXPIRES_IN=8h
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Salt para HMAC-SHA256 del IP en access-requests (ipHash). Sin este valor,
# ipHash se guarda como null en vez de usar un hash sin salt (reversible).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_REQUEST_IP_SALT=dev-ip-salt-no-usar-en-prod

# Número de saltos de reverse proxy confiables para 'trust proxy' (Express).
# Determina cuántos hops de X-Forwarded-For se confían al resolver req.ip.
# Debe coincidir con la topología real (nginx = 1; nginx + CDN = 2; etc.),
# o el throttle por IP en /api/public/access-requests se puede evadir.
TRUST_PROXY_HOPS=1

# ──── Entorno ──────────────────────────────────────────────
NODE_ENV=development

# ============================================================
# ZDR / Agentes Python (legado)
# ============================================================

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Canales Discord (IDs numéricos)
CHANNEL_SALA_OPERACIONES=
CHANNEL_ARQUITECTURA=
CHANNEL_DEV=
CHANNEL_CONTENIDO=
CHANNEL_QA=

# OpenRouter — rutas ZDR
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos ZDR (verificar precios en openrouter.ai antes de producción)
MODEL_MISTRAL=mistralai/mistral-small-2603
MODEL_QWEN=qwen/qwen3.6-35b-a3b
MODEL_AUTO_PRIMARY=mistralai/mistral-small-2603
MODEL_AUTO_FALLBACK=qwen/qwen3.6-35b-a3b

# Memoria
MEMORY_DB_PATH=data/memory.db
MEMORY_MAX_CONTEXT_TOKENS=4096
MEMORY_RETENTION_DAYS=90

# Seguridad
MAX_DELEGATION_DEPTH=3
MAX_TOKENS_PER_REQUEST=2048
ZDR_ENABLED=true
ZDR_LOG_SANITIZATION=true

# Logging (legado)
ENV=development
LOG_LEVEL=INFO
LOG_FILE=data/office.log
