# ============================================================
# Grupo Security Office — Variables de Entorno
# ============================================================
# Copiar a .env y ajustar valores
#   cp .env.example .env
# Nunca comitear .env al repo.

# ──── PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grupo_security?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grupo_security

# ──── API (NestJS) ─────────────────────────────────────────
JWT_SECRET=dev-secret-no-usar-en-prod
JWT_EXPIRES_IN=8h
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ──── Entorno ──────────────────────────────────────────────
NODE_ENV=development

# ──── Frontend (Vite) ──────────────────────────────────────
# Overlay de anotaciones (agentation). En dev se activa solo; fuera de dev
# requiere VITE_AGENTATION_ENABLED=true.
# VITE_AGENTATION_ENABLED=true
# Daemon agentation (npx agentation-mcp server --port 4747). Si se omite, el
# frontend usa http://<host-de-la-pagina>:4747, que funciona desde cualquier
# maquina. Solo hace falta fijarlo si el daemon esta en otro host/puerto.
# VITE_AGENTATION_URL=http://100.87.48.41:4747

# ============================================================
# ZDR / Agentes Python (legado)
# ============================================================

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Canales Discord (IDs numéricos)
CHANNEL_SALA_OPERACIONES=
CHANNEL_ARQUITECTURA=
CHANNEL_DEV=
CHANNEL_CONTENIDO=
CHANNEL_QA=

# OpenRouter — rutas ZDR
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos ZDR (verificar precios en openrouter.ai antes de producción)
MODEL_MISTRAL=mistralai/mistral-small-2603
MODEL_QWEN=qwen/qwen3.6-35b-a3b
MODEL_AUTO_PRIMARY=mistralai/mistral-small-2603
MODEL_AUTO_FALLBACK=qwen/qwen3.6-35b-a3b

# Memoria
MEMORY_DB_PATH=data/memory.db
MEMORY_MAX_CONTEXT_TOKENS=4096
MEMORY_RETENTION_DAYS=90

# Seguridad
MAX_DELEGATION_DEPTH=3
MAX_TOKENS_PER_REQUEST=2048
ZDR_ENABLED=true
ZDR_LOG_SANITIZATION=true

# Logging (legado)
ENV=development
LOG_LEVEL=INFO
LOG_FILE=data/office.log
