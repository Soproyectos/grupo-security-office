{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    ".kilo/rules/*.md",
    ".kilo/context/*.md"
  ],
  "snapshot": false,
  "mcp": {
    "agentation": {
      "type": "local",
      "command": ["npx", "-y", "agentation-mcp", "server", "--mcp-only", "--http-url", "http://localhost:4747"],
      "enabled": true
    }
  }
}