# Backend environment example (NestJS + TypeScript + Prisma).
# Copy this file to .env and fill in values for your environment.
# **NEVER commit real secrets, passwords, or connection strings.**

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sesión y JWT
# ---------------------------------------------------------------------------
# Obligatoria. Sin ella la aplicación no arranca (no hay valor por defecto).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Duración de la sesión, en horas. Las cuentas privilegiadas (Super Admin)
# usan la variante corta: cuanto más poder tiene una sesión, menos debe vivir.
SESSION_HOURS=8
SESSION_HOURS_PRIVILEGED=2

# ---------------------------------------------------------------------------
# Segundo factor (MFA / TOTP) — Fase S del hardening
# ---------------------------------------------------------------------------
# OBLIGATORIA. Clave AES-256-GCM con la que se cifran los secretos TOTP en
# reposo. Sin ella la aplicación NO arranca, y es deliberado: guardar los
# secretos en claro convertiría el segundo factor en un adorno frente a una
# filtración de la base de datos.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ATENCIÓN: si se pierde o se cambia esta clave, los secretos TOTP existentes
# dejan de poder descifrarse y todos los usuarios con MFA deben volver a
# enrolarse usando sus códigos de respaldo.
MFA_ENCRYPTION_KEY=

# Nombre que muestra la app de autenticación (Google Authenticator, Authy…).
MFA_ISSUER=Grupo Security

# ---------------------------------------------------------------------------
# Contraseñas del seed
# ---------------------------------------------------------------------------
# Se usan SÓLO al crear el usuario por primera vez. El seed nunca modifica la
# contraseña de un usuario que ya existe (ver SEC-SEED-001 en prisma/seed.ts).
# Si se dejan vacías, el seed genera una contraseña aleatoria y la imprime una
# única vez en la consola.
#
# Deben cumplir la política de seguridad: mínimo 12 caracteres y sin términos
# del negocio ('grupo', 'security', 'admin'…). 'admin123' es rechazada.
SEED_SUPER_ADMIN_PASSWORD=
SEED_COMPRAS_PASSWORD=

# ---------------------------------------------------------------------------
# Red y entorno
# ---------------------------------------------------------------------------
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Límite de peticiones global (ventana en ms / máximo de peticiones).
# El login tiene además su propio límite más estricto, y el bloqueo de cuenta
# por intentos fallidos es independiente de estos valores.
THROTTLE_TTL=60000
THROTTLE_LIMIT=20
