FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache openssl python3 make g++
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --ignore-scripts --no-audit --no-fund && npm rebuild bcrypt --build-from-source && npx prisma generate
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY eslint.config.* ./
COPY src ./src
RUN npm run build
EXPOSE 3000
CMD ["node", "dist/src/main"]
