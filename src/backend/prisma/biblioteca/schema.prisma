// Biblioteca de desarrollo. Base T03 congelada en biblioteca-candidata; cambios nuevos por migraciones.
// Sin FK a usuarios/operaciones. No aplicada en producción.
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url = env("LIBRARY_DATABASE_URL")
}

model Lista {
  id                    String    @id @default(uuid())
  code                  String    @unique
  name                  String
  description           String?
  currency              String    @default("COP")
  isActive              Boolean   @default(true)
  archivedAt            DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  defaultVisibility     Boolean   @default(false)
  responsibleId         String?
  type                  String?
  validFrom             DateTime?
  validUntil            DateTime?
  codigo                String?   @unique
  deletionStatus        String?
  deletionRequestedAt   DateTime?
  deletionPurgeAt       DateTime?
  deletionReason        String?
  deletionRequestedById String?
  prices                Price[]
  products              Product[]
  priceImportRevisions  PriceImportRevision[]

  @@index([isActive])
  @@index([archivedAt])
  @@index([responsibleId])
  @@index([deletionPurgeAt])
  @@map("listas")
}

model Product {
  id                     String                    @id @default(uuid())
  /// Identity is case/whitespace-insensitive: migration 20261002200000_products_sku_normalized_unique
  /// adds the expression index products_sku_normalized_key ON (upper(regexp_replace(sku, '\s', '', 'g'))).
  /// Prisma cannot model it; match products with findProductsBySkus() / normalizeSku(), never `where: { sku }`.
  sku                    String                    @unique
  name                   String
  description            String?
  categoryId             String
  brandId                String
  technicalSpecs         Json?
  isActive               Boolean                   @default(false)
  isVisible              Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  extraAttributes        Json?
  listaId                String?
  publishAt              DateTime?
  publishStatus          String                    @default("borrador")
  publishedAt            DateTime?
  publishedById          String?
  unpublishAt            DateTime?
  unpublishReason        String?
  documents              Json?
  lifecycleStatus        String                    @default("DRAFT")
  nameSource             String                    @default("sistema")
  nameLockedAt           DateTime?
  lastSeenAt             DateTime?
  catalogAvailableModels String[]                  @default([])
  catalogBadges          String[]                  @default([])
  catalogBrand           String?
  catalogBreadcrumb      Json                      @default("[]")
  catalogFeatures        Json                      @default("[]")
  catalogFirmwareNote    String?
  catalogHighlights      String[]                  @default([])
  catalogImageAlt        String?
  catalogImageUrl        String?
  catalogModel           String?
  catalogName            String?
  catalogPublished       Boolean                   @default(false)
  catalogSlug            String?                   @unique
  catalogSpecsDisclaimer String?
  /// CAT-03 (H1): notas INTERNAS de la ficha. No se publican en la tienda ni
  /// salen en una exportación ordinaria; leerlas/editarlas exige `products:notes`.
  catalogInternalNotes   String?
  /// CAT-03 (H4): identificadores del fabricante (part number, EAN…). Público.
  catalogManufacturerRefs String[]                 @default([])
  /// CAT-03 (H2): versión de la ficha para el control de concurrencia (OCC).
  sheetVersion           Int                       @default(0)
  catalogStatus          ProductCatalogStatus?     @default(ACTIVE)
  prices                 Price[]
  catalogResources       ProductCatalogResource[]
  catalogSpecGroups      ProductCatalogSpecGroup[]
  internalNotes          ProductInternalNote[]
  images                 ProductImage[]
  brand                  Brand                     @relation(fields: [brandId], references: [id])
  category               Category                  @relation(fields: [categoryId], references: [id])
  lista                  Lista?                    @relation(fields: [listaId], references: [id])
  /// CAT-02/K2: referencia pública ACTIVA (la revisión publicada que sirve el catálogo).
  publicRevisionId       String?
  publicRevision         ProductRevision?          @relation("ProductPublicRevision", fields: [publicRevisionId], references: [id], onDelete: SetNull)
  /// CAT-06 (T2): revisión CONGELADA al programar la publicación. El scheduler
  /// publica esta revisión (nunca el borrador posterior). Sin FK dura: borrar
  /// la revisión no debe borrar el producto; el disparo la resuelve con
  /// fallback defensivo si ya no existe (documentado en el contrato §3.2).
  scheduledRevisionId    String?
  revisions              ProductRevision[]

  @@index([categoryId])
  @@index([brandId])
  @@index([listaId])
  @@index([publishStatus])
  @@index([publishAt])
  @@index([unpublishAt])
  @@index([publicRevisionId])
  @@index([isActive, isVisible])
  @@index([lifecycleStatus])
  @@index([catalogPublished, catalogBrand])
  @@map("products")
  gaps ProductGap[]
  evidence FieldEvidence[]
  supplierCosts SupplierCost[]
  providerEquivalences ProviderEquivalence[]

}

/// Internal (private) notes of a product, one row per note. Never published.
/// Author is a plain id + frozen display name (no FK to users): the dedicated library database has no users table.
/// authorId NULL + authorName 'Sistema' = notes migrated from the legacy single-text column.
model ProductInternalNote {
  id         String   @id @default(uuid())
  productId  String
  authorId   String?
  authorName String
  text       String
  /// Optimistic-concurrency counter: starts at 0, +1 per edit.
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt(sort: Desc)])
  @@map("product_internal_notes")
}

model ProductCatalogSpecGroup {
  id        String                   @id @default(uuid())
  productId String
  key       String
  title     String
  position  Int
  product   Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     ProductCatalogSpecItem[]

  @@unique([productId, key])
  @@index([productId, position])
  @@map("product_catalog_spec_groups")
}

model ProductCatalogSpecItem {
  id       String                  @id @default(uuid())
  groupId  String
  label    String
  value    String
  position Int
  group    ProductCatalogSpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
  @@map("product_catalog_spec_items")
}

model ProductCatalogResource {
  id              String              @id @default(uuid())
  productId       String
  kind            ProductResourceKind
  title           String
  language        String              @default("es")
  url             String
  fileName        String?
  version         String?
  region          String?
  requiresLicense Boolean             @default(false)
  position        Int                 @default(0)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind])
  @@map("product_catalog_resources")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String     @unique
  parentId    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  iconUrl     String?    @db.VarChar(500)
  imageUrl    String?    @db.VarChar(500)
  isFeatured  Boolean    @default(false)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model ProductRevision {
  id          String         @id
  productId   String
  createdById String?
  status      RevisionStatus
  notes       String?        @db.Text
  /// Versión esperada para OCC (pasos backend-borradores).
  version     Int
  /// Snapshot del contenido publicable (identidad, ficha y referencias de medios).
  content     Json
  publishedAt DateTime?
  /// CAT-05 (D4): informe de validación VINCULADO A ESTA REVISIÓN — fecha del
  /// run, versión de reglas vigente y incidencias. Obsoleto si la revisión deja
  /// de ser la de trabajo, si cambia `rulesVersion` o si editar crea una nueva.
  validatedAt  DateTime?
  rulesVersion String?
  issues       Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// La referencia pública activa (SetNull: borrar revisión no borra producto).
  publicFor   Product[]      @relation("ProductPublicRevision")

  @@unique([productId, version])
  @@index([productId, status])
  @@map("product_revisions")
}

model PublicationEvent {
  id        String   @id @default(uuid())
  productId String
  revisionId String?
  action    String // PUBLISH | UNPUBLISH | SCHEDULE | UNSCHEDULE | SCHEDULE_PUBLISHED | SCHEDULE_BLOCKED
  result    String // ok | blocked | failed
  actorId   String?
  issues    Json?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([action, createdAt])
  @@map("publication_events")
}

model CatalogJob {
  id             String    @id @default(uuid())
  kind           String // VALIDATION_SCAN (ahora) | EXPORT_BUNDLE (CAT-08, reservado)
  actorId        String // creador; la re-verificación de permisos al ejecutar es sobre él
  scope          Json // {mode:'ids',ids:[…]} | {mode:'filters',listaId?,search?,lifecycleStatus?}
  state          String    @default("QUEUED") // QUEUED|RUNNING|COMPLETED|COMPLETED_WITH_ERRORS|FAILED|CANCELLED|EXPIRED
  progressDone   Int       @default(0)
  progressTotal  Int       @default(0)
  checkpoint     Json? // cursor reasumible {lastUnitId} + contadores del lote en curso
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3)
  leaseUntil     DateTime?
  retryKey       String?
  resultSummary  Json? // derivado de las UNIDADES (nunca sumas a mano) — caso 1
  error          String? // p.ej. 'permission-revoked'
  cancelRequested Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  units CatalogJobUnit[]
  exportBundle ExportBundle?

  // Dedupe de reintentos (diseño :339 «clave de reintento»): el mismo
  // (kind, actor, retryKey) reencolado devuelve el trabajo existente.
  @@unique([kind, actorId, retryKey], map: "catalog_jobs_kind_actor_retry_key_key")
  @@index([state, leaseUntil])
  @@index([actorId, createdAt])
  @@map("catalog_jobs")
}

model ExportBundle {
  id           String    @id @default(uuid())
  jobId        String    @unique
  actorId      String
  bundleBytes  Bytes
  sizeBytes    Int
  sha256       String
  manifestJson Json
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  job          CatalogJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([expiresAt])
  @@map("export_bundles")
}

model CatalogJobUnit {
  jobId    String
  unitId   String
  state    String   @default("PENDING") // PENDING|DONE|OMITTED|FAILED
  error    String?
  attempts Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  job CatalogJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, unitId])
  @@index([jobId, state])
  @@map("catalog_job_units")
}

model PriceImportRevision {
  id             String                    @id @default(uuid())
  /// Nullable since 2026-10-20: a revision may span several listas (rows carry their own listaId snapshot).
  listaId        String?
  createdById    String?
  fileName       String
  fileHash       String
  fileSize       Int
  storagePath    String?
  idempotencyKey String
  status         PriceImportRevisionStatus @default(GUARDADA)
  currency       String                    @default("COP")
  taxIncluded    Boolean                   @default(true)
  rounding       String                    @default("HALF_UP")
  policyVersion  String
  parserVersion  String
  trailerVersion String?
  tariffs        Json
  summary        Json
  appliedAt      DateTime?
  appliedById    String?
  appliedResult  Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  lista          Lista?                    @relation(fields: [listaId], references: [id], onDelete: SetNull)
  rows           PriceImportRevisionRow[]
  prices         PriceImportRevisionPrice[]

  @@unique([idempotencyKey])
  @@index([listaId, status])
  @@index([createdById])
  @@index([status])
  @@map("price_import_revisions")
}

model PriceImportRevisionRow {
  id         String              @id @default(uuid())
  revisionId String
  rowNumber  Int
  sku        String
  status     String
  issues     Json
  /// Snapshots without FKs: they must never block product/lista deletion.
  productId  String?
  listaId    String?
  /// null | PENDING_PRODUCT | PRODUCT_CREATED | SKIPPED
  resolution String?
  resolvedAt DateTime?
  resolvedById String?
  revision   PriceImportRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, rowNumber])
  @@index([revisionId, status])
  @@index([listaId])
  @@index([productId])
  @@map("price_import_revision_rows")
}

model PriceImportRevisionPrice {
  id            String              @id @default(uuid())
  revisionId    String
  rowNumber     Int
  sku           String
  tariffCode    String
  priceListId   String?
  receivedValue String
  roundedValue  String
  previousValue String?
  difference    String?
  wasRounded    Boolean
  change        String
  productId     String?
  changePercent Decimal?            @db.Decimal(9, 2)
  largeChange   Boolean             @default(false)
  revision      PriceImportRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, rowNumber, tariffCode], map: "price_import_revision_prices_revisionId_rowNumber_tariffCode_ke")
  @@index([revisionId])
  @@map("price_import_revision_prices")
}

model ProductChange {
  id        String   @id @default(uuid())
  productId String
  sku       String
  /// name | description | brandId | categoryId | lifecycleStatus | listaId | price:<TARIFF>
  field     String
  oldValue  Json?
  newValue  Json?
  /// PRICE_IMPORT | MANUAL | PRODUCT_IMPORT | BIBLIOTECA_IMPORT | LIFECYCLE | SYSTEM
  source    String
  sourceRef String?
  actorId   String?
  batchId   String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([sourceRef])
  @@map("product_changes")
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  type      ProductImageType @default(PRINCIPAL)
  product   Product          @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model PriceList {
  id                      String                   @id @default(uuid())
  name                    String
  code                    String                   @unique
  currency                String                   @default("COP")
  isActive                Boolean                  @default(true)
  validFrom               DateTime?
  validUntil              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  prices                  Price[]

  @@map("price_lists")
}

model Price {
  id          String      @id @default(uuid())
  productId   String
  priceListId String
  value       Decimal     @db.Decimal(12, 2)
  currency    String      @default("COP")
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  listaId     String?
  lista       Lista?      @relation(fields: [listaId], references: [id])
  priceList   PriceList   @relation(fields: [priceListId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@unique([productId, priceListId])
  @@index([productId])
  @@index([priceListId])
  @@index([listaId])
  @@map("prices")
}

model ImportMapping {
  id        String   @id @default(uuid())
  name      String
  mappings  Json
  userId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("import_mappings")
}

model ProviderProfile {
  id                 String                @id @default(uuid())
  providerName       String                @unique
  sheet              String
  headerRow          Int                   @default(1)
  thousandsSeparator String                @default("")
  decimalSeparator   String                @default(".")
  currency           String                @default("COP")
  tariffs            Json
  expectedColumns    Json
  version            Int                   @default(1)
  createdById        String?
  updatedById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  isActive           Boolean               @default(true) @map("is_active")
  equivalences       ProviderEquivalence[]

  @@map("provider_profiles")
  supplierCosts SupplierCost[]

}

model ProviderEquivalence {
  id                String          @id @default(uuid())
  providerProfileId String
  externalRef       String
  productId         String
  normalizedRef     String          @map("normalized_ref")
  refKind           String          @default("PROVEEDOR") @map("ref_kind")
  isPrimary         Boolean         @default(false) @map("is_primary")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  profile           ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Índice único parcial (producto, proveedor) WHERE is_primary y CHECK de ref_kind: solo en SQL.
  @@unique([providerProfileId, externalRef])
  @@unique([providerProfileId, normalizedRef])
  @@index([productId])
  @@map("provider_equivalences")
}

model ImportSession {
  id        String   @id
  userId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("import_sessions")
}

enum PriceImportRevisionStatus {
  GUARDADA
  APLICADA
  DESCARTADA
}

enum RevisionStatus {
  SIN_REVISAR
  CON_PROBLEMAS
  LISTA_PARA_PUBLICAR
  REVISION_PENDIENTE
  PUBLICADA
}

enum ProductCatalogStatus {
  ACTIVE
  DISCONTINUED
}

enum ProductResourceKind {
  DATASHEET
  MANUAL
  QUICK_GUIDE
  CERTIFICATE
  OTHER_DOCUMENT
  FIRMWARE
  RELEASE_NOTES
}

enum ProductImageType {
  PORTADA
  LOGO
  PRINCIPAL
  COMPLEMENTARIA
  EXTRA
}

model LibraryAuditEvent {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamp(3)
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  summary    Json
  requestId  String?  @map("request_id")

  @@index([occurredAt(sort: Desc)], map: "library_audit_events_occurred_at_idx")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "library_audit_events_entity_idx")
  @@map("library_audit_events")
}

// Additive development contracts; no publication policy or official field selection.
model ProductGap {
  id String @id @default(uuid())
  productId String @map("product_id")
  gapKey String @map("gap_key")
  status String
  severity String
  reason String?
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamp(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamp(3)
  setByActorId String? @map("set_by_actor_id")
  setByActorName String? @map("set_by_actor_name")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Open-gap uniqueness is a partial SQL index in the additive migration.
  @@index([productId], map: "product_gaps_product_idx")
  @@map("product_gaps")
}

model FieldEvidence {
  id String @id @default(uuid())
  productId String @map("product_id")
  fieldKey String @map("field_key")
  level String
  sourceKind String @map("source_kind")
  sourceUrl String? @map("source_url")
  reason String?
  valueHash String? @map("value_hash")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamp(3)
  actorId String? @map("actor_id")
  actorName String? @map("actor_name")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldKey], map: "field_evidence_product_field_key")
  @@map("field_evidence")
}

model SupplierCost {
  id String @id @default(uuid())
  productId String @map("product_id")
  providerProfileId String @map("provider_profile_id")
  amount Decimal @db.Decimal(14, 2)
  currency String @default("COP")
  taxIncluded Boolean @map("tax_included")
  validFrom DateTime? @map("valid_from") @db.Timestamp(3)
  validUntil DateTime? @map("valid_until") @db.Timestamp(3)
  sourceRevisionId String? @map("source_revision_id")
  createdByActorId String? @map("created_by_actor_id")
  createdByActorName String? @map("created_by_actor_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  provider ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)

  @@index([productId, providerProfileId, validFrom(sort: Desc)], map: "supplier_costs_product_provider_date_idx")
  @@map("supplier_costs")
}


// D1 confirmed: current product/brand file contract; storage policy D7 unchanged.
model UploadedFile {
  id        String   @id @default(uuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  /// CAT-04 (D1): metadatos de activos — columnas ADITIVAS; las filas antiguas
  /// quedan visibility='PUBLIC' con metadata NULL (compatibilidad K4 y caché
  /// immutable). sha256 en hex minúscula; detectedKind por firma mágica
  /// (IMAGE|PDF|ZIP|UNKNOWN), no por el mimeType declarado.
  sizeBytes      Int?
  sha256         String?
  detectedKind   String?
  originalName   String?
  visibility     String @default("PUBLIC")
  ownerProductId String?

  @@index([ownerProductId])
  @@index([visibility])
  @@map("uploaded_files")
}
