// driverAdapters: las consultas van por el driver JS de Neon
// (@prisma/adapter-neon + @neondatabase/serverless) en vez de por el
// conector nativo en Rust del motor de Prisma. Esto evita por completo
// el panic "PANIC: timer has gone away" (crate futures-timer) visto en
// runtime en Hostinger — un bug conocido del motor nativo de Prisma en
// hosting compartido (github.com/prisma/prisma/issues/26073 y otros,
// sin fix oficial de Prisma al momento de este cambio). engineType no
// puede usarse junto con driverAdapters.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  name                    String
  password                String
  isActive                Boolean              @default(true)
  roles                   UserRole[]
  auditLogs               AuditLog[]
  assignments             Assignment[]
  createdListas           Lista[]              @relation("ListaCreator")
  updatedListas           Lista[]              @relation("ListaUpdater")
  responsibleListas       Lista[]              @relation("ListaResponsible")
  deletionRequestedListas Lista[]              @relation("ListaDeletionRequester")
  publishedProducts       Product[]            @relation("ProductPublishedBy")
  supervisorId            String?
  supervisor              User?                @relation("UserHierarchy", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates            User[]               @relation("UserHierarchy")
  ownedCustomers          Customer[]           @relation("CustomerOwner")
  createdCustomers        Customer[]           @relation("CustomerCreator")
  ownedQuotes             Quote[]              @relation("QuoteOwner")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([supervisorId])
  @@map("users")
}

model Assignment {
  id           String   @id @default(uuid())
  userId       String
  roleId       String?
  resourceType String
  resourceId   String
  level        String   @default("view")
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role?    @relation("RoleAssignments", fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([roleId])
  @@map("assignments")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  assignments Assignment[]     @relation("RoleAssignments")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  role       Role     @relation(fields: [roleId], references: [id])
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  @@id([roleId, permission])
  @@map("role_permissions")
}

model Lista {
  id                    String    @id @default(uuid())
  code                  String    @unique
  codigo                String?   @unique
  name                  String
  description           String?
  type                  String?
  defaultVisibility     Boolean   @default(false)
  currency              String    @default("COP")
  isActive              Boolean   @default(true)
  archivedAt            DateTime?
  deletionStatus        String? // null | 'PENDING_DELETION'
  deletionRequestedAt   DateTime?
  deletionPurgeAt       DateTime? // solicitud + 90d en America/Bogota
  deletionReason        String?
  deletionRequestedById String?
  createdById           String?
  updatedById           String?
  responsibleId         String?
  validFrom             DateTime?
  validUntil            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  creator           User?     @relation("ListaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updater           User?     @relation("ListaUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  responsible       User?     @relation("ListaResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  deletionRequester User?     @relation("ListaDeletionRequester", fields: [deletionRequestedById], references: [id], onDelete: SetNull)

  products Product[]
  prices   Price[]
  quotes   Quote[]  @relation("QuoteLista")

  @@index([isActive])
  @@index([archivedAt])
  @@index([responsibleId])
  @@index([deletionPurgeAt]) // para scheduler de purga de Listas vencidas
  @@map("listas")
}

model Product {
  id              String         @id @default(uuid())
  sku             String         @unique
  name            String
  description     String?
  categoryId      String
  brandId         String
  listaId         String?
  technicalSpecs  Json?
  extraAttributes Json?
  documents       Json?
  isActive        Boolean        @default(false)
  isVisible       Boolean        @default(false)
  publishStatus   String         @default("borrador")
  publishedAt     DateTime?
  publishAt       DateTime?
  unpublishAt     DateTime?
  publishedById   String?
  unpublishReason String?
  lifecycleStatus String         @default("DRAFT")
  category        Category       @relation(fields: [categoryId], references: [id])
  brand           Brand          @relation(fields: [brandId], references: [id])
  lista           Lista?         @relation(fields: [listaId], references: [id])
  publishedBy     User?          @relation("ProductPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  prices          Price[]
  images          ProductImage[]
  auditLogs       AuditLog[]
  stock           Stock?
  quoteItems      QuoteItem[]      @relation("QuoteItemProduct")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([listaId])
  @@index([publishStatus])
  @@index([publishAt])
  @@index([unpublishAt])
  @@index([isActive, isVisible])
  @@index([lifecycleStatus])
  @@map("products")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

enum ProductImageType {
  PORTADA
  LOGO
  PRINCIPAL
  COMPLEMENTARIA
  EXTRA
}

model ProductImage {
  id        String           @id @default(uuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  url       String
  alt       String?
  type      ProductImageType @default(PRINCIPAL)
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)

  @@index([productId])
  @@map("product_images")
}

/// Bytes de archivos subidos (imágenes de producto, logos de marca),
/// almacenados directamente en Postgres. Reemplaza el guardado en disco
/// local (process.cwd()/uploads): en Hostinger cada despliegue corre en un
/// directorio de versión nuevo (confirmado en runtime logs), y el disco no
/// se comparte entre instancias — los archivos subidos se perdían o eran
/// invisibles para la instancia que atendía la lectura, aunque el registro
/// en BD (ProductImage.url / Brand.logo) sobreviviera. Servido vía
/// GET /api/files/:id (FilesController).
model UploadedFile {
  id        String   @id @default(uuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploaded_files")
}

model PriceList {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  currency   String    @default("COP")
  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  prices     Price[]
  quotes     Quote[]    @relation("QuotePriceList")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("price_lists")
}

model Price {
  id          String    @id @default(uuid())
  productId   String
  priceListId String
  listaId     String?
  product     Product     @relation(fields: [productId], references: [id])
  priceList   PriceList   @relation(fields: [priceListId], references: [id])
  lista       Lista?      @relation(fields: [listaId], references: [id])
  quoteItems  QuoteItem[] @relation("QuoteItemPrice")
  value       Decimal   @db.Decimal(12, 2)
  currency    String    @default("COP")
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, priceListId])
  @@index([productId])
  @@index([priceListId])
  @@index([listaId])
  @@map("prices")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  result    String? // 'SUCCESS' | 'ERROR' | 'WARNING'

  @@index([entity, entityId])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ImportMapping {
  id        String   @id @default(uuid())
  name      String
  mappings  Json
  userId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("import_mappings")
}

/// Estado del wizard de importación (preview → execute) persistido en BD.
/// Antes vivía en un Map en memoria del proceso de ImportService: si Hostinger
/// enruta la petición de `execute` a otra instancia/proceso distinto al que
/// atendió `preview` (o el proceso se reinicia entre medio), el contexto se
/// perdía y el usuario recibía "Importación no encontrada" sin causa visible.
/// `data` serializa el ImportContext completo (ver import-context.ts).
model ImportSession {
  id        String   @id
  userId    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("import_sessions")
}

/// Cliente o lead del módulo comercial. Un lead y un cliente son el MISMO
/// registro, distinguidos por `status` (LEAD puede cotizar; la conversión
/// lead→cliente no copia filas ni rompe referencias de cotizaciones).
/// `city` es texto libre por decisión de producto (no se modelan sedes/ciudades).
model Customer {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  documentType  String?
  documentId    String?
  email         String?
  phone         String?
  city          String?
  address       String?
  status        String    @default("LEAD") // LEAD | CLIENTE | INACTIVO
  source        String? // REFERIDO | PROMOCION | LLAMADA_FRIA | WEB | EVENTO | OTRO
  sourceDetail  String?
  ownerId       String?
  createdById   String?
  convertedAt   DateTime?
  lastContactAt DateTime?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     User? @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quotes    Quote[]

  @@unique([documentType, documentId])
  @@index([ownerId, status])
  @@index([status])
  @@index([createdAt])
  @@map("customers")
}

model Stock {
  id           String   @id @default(uuid())
  productId    String   @unique
  availableQty Int      @default(0)
  reservedQty  Int      @default(0)
  location     String?
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stocks")
}

/// Cotización comercial. El ítem CONGELA el precio (snapshot): `QuoteItem`
/// guarda su propio `unitPrice` (no se recalcula desde `Price` después), por
///que cambios posteriores en la tarifa no deben alterar cotizaciones históricas.
/// Toda la aritmética de montos la hace el backend; los totales están
/// denormalizados en el propio registro (SUM indexable para métricas).
model Quote {
  id          String    @id @default(uuid())
  code        String    @unique
  customerId  String
  ownerId     String
  listaId     String
  priceListId String?
  status      String    @default("borrador") // borrador|enviada|negociacion|ganada|perdida|cancelada|vencida
  currency    String    @default("COP")
  subtotal    Decimal   @default(0) @db.Decimal(14, 2)
  discount    Decimal   @default(0) @db.Decimal(14, 2)
  taxRate     Decimal   @default(19) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(14, 2)
  total       Decimal   @default(0) @db.Decimal(14, 2)
  validUntil  DateTime?
  issuedAt    DateTime?
  closedAt    DateTime?
  lostReason  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner     User       @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  lista     Lista      @relation("QuoteLista", fields: [listaId], references: [id], onDelete: Restrict)
  priceList PriceList? @relation("QuotePriceList", fields: [priceListId], references: [id], onDelete: SetNull)
  items     QuoteItem[]

  @@index([ownerId, status])
  @@index([ownerId, closedAt])
  @@index([customerId])
  @@index([status])
  @@index([listaId])
  @@map("quotes")
}

/// Línea de cotización con snapshot de precio. `productId`/`priceId` son solo
/// trazabilidad ("de dónde salió este número"), nunca para recalcular.
model QuoteItem {
  id       String @id @default(uuid())
  quoteId  String
  position Int    @default(0)

  productId String?
  priceId   String?

  sku             String
  name            String
  listaId         String?
  priceListId     String?
  unitPrice       Decimal  @db.Decimal(12, 2)
  currency        String   @default("COP")
  quantity        Int      @default(1)
  discountPct     Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal  @db.Decimal(14, 2)
  priceCapturedAt DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation("QuoteItemProduct", fields: [productId], references: [id], onDelete: SetNull)
  price   Price?   @relation("QuoteItemPrice", fields: [priceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model SalesOrder {
  id                  String   @id @default(uuid())
  externalInvoiceNumber String   @unique
  orderDate           DateTime
  totalAmount         Decimal  @db.Decimal(12, 2)
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([externalInvoiceNumber])
  @@index([orderDate])
  @@map("sales_orders")
}

